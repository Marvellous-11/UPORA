# =============================================================
# UPORA ENVIRONMENT CONFIGURATION
# =============================================================

# PostgreSQL Database Connection URL (Prisma)
# Example for local: postgresql://postgres:postgres@localhost:5432/upora?schema=public
# Example for Neon/Supabase: postgresql://user:password@ep-host.region.neon.tech/upora?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/upora?schema=public"

# Session & JWT Cryptographic Secret (Minimum 32 random characters)
JWT_SECRET="upora_super_secret_jwt_key_32_characters_minimum_production_grade"

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
